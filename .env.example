# =========================================================
# LEVEL UP SYSTEM — Frontend Environment (.env.local)
# Copy to .env.local and fill in your credentials.
# Never commit .env.local to git!
# =========================================================

# --- 1. Firebase Cloud Sync (Auth + Firestore) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- 2. Admin & Shared AI Proxy Server ---
# Bootstrap super-admin email (must match firestore.rules & server/.env.local)
VITE_ADMIN_EMAIL=admin@example.com
# Shared AI Proxy URL:
# - Leave empty in local dev (Vite proxies /api/* -> http://localhost:8787)
# - Or set to your deployed Render / Railway / Cloud Functions URL (e.g. https://level-up-ai-proxy.onrender.com)
VITE_AI_PROXY_URL=

# --- 3. Personal Agnes AI Defaults (Optional BYOK) ---
VITE_AI_BASE_URL=https://apihub.agnes-ai.com/v1
VITE_AI_MODEL=agnes-2.5-flash
VITE_AI_API_KEY=

# Public client identifier for Google OAuth and direct Calendar read access.
VITE_GOOGLE_OAUTH_CLIENT_ID=
# Set to false only if you want to temporarily hide direct Google Calendar OAuth.
VITE_CALENDAR_OAUTH_ENABLED=true
