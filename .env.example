# =========================================================
# LEVEL UP SYSTEM — Environment Configuration (.env.local)
# Copy this file to .env.local and fill in your credentials.
# Never commit .env.local to git!
# =========================================================

# --- 1. Firebase Cloud Sync (Auth + Firestore) ---
# Get these from Firebase Console > Project Settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- 2. Agnes AI / OpenAI-Compatible API (Optional default) ---
# You can also set or override these securely inside the app Settings modal.
VITE_AI_BASE_URL=https://apihub.agnes-ai.com/v1
VITE_AI_MODEL=agnes-2.5-flash
VITE_AI_API_KEY=
