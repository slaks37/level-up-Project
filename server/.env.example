# =========================================================
# LEVEL UP SYSTEM — Secure AI Proxy Server (.env.local)
# Copy to server/.env.local and fill in your credentials.
# Never commit .env.local or service account keys to git!
# =========================================================

PORT=8787
ADMIN_EMAIL=admin@example.com

# Firebase Project (used to verify user Firebase Auth ID tokens)
FIREBASE_PROJECT_ID=level-up-os-sl26
FIREBASE_WEB_API_KEY=

# Optional: Firebase Admin SDK Service Account JSON (for Firestore sync & audit logs)
# Either set path to JSON file OR paste single-line JSON string
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Shared Agnes AI Provider Defaults (can also be updated live from Admin Page!)
AGNES_AI_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_AI_MODEL=agnes-2.5-flash
AGNES_AI_API_KEY=
DEFAULT_DAILY_LIMIT=20

# Comma-separated allowed browser origins (* allows all)
ALLOWED_ORIGINS=http://localhost:5173,https://level-up-os-sl26.web.app,https://level-up-os-sl26.firebaseapp.com
